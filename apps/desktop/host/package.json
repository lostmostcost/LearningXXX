{
  "name": "@learningxxx/desktop-host",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:@anthropic-ai/claude-agent-sdk --external:electron --external:pdfjs-dist --outfile=dist/main.cjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "start": "pnpm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "44.9.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@learningxxx/app-modifier": "workspace:*",
    "@learningxxx/cli-adapter": "workspace:*",
    "@learningxxx/collector": "workspace:*",
    "@learningxxx/contracts": "workspace:*",
    "@learningxxx/transcriber": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7"
  }
}
